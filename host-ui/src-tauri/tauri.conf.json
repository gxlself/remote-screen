{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Host",
  "identifier": "ai.gxlself.remotehost",
  "version": "1.0.0",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/rs-host-agent"],
    "macOS": {
      "files": {
        "Library/LaunchAgents/ai.gxlself.remotehost.agent.plist": "./macos/ai.gxlself.remotehost.agent.plist"
      },
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
