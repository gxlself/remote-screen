{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Remote Screen main window: core, events and dialogs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message"
  ]
}
