# Local, gitignored signing files are the default; no config server is required.
# For optional Nacos sync, copy this file to a private location and set
# NACOS_CONFIG_FILE=/absolute/path/to/your/file. Never commit filled values.
# Environment variables take precedence over values here. Both credentials may
# be empty for anonymous access; if using authentication, set both.
BUILD_SECRETS_PROVIDER=nacos
NACOS_SERVER=
NACOS_NAMESPACE=
NACOS_GROUP=
NACOS_DATA_ID=
NACOS_USERNAME=
NACOS_PASSWORD=
