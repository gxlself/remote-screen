{
  "name": "remote-screen",
  "version": "1.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gxlself/remote-screen.git"
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "bindings": "bash scripts/generate-bindings.sh"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.88.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.104.5",
    "@ubjs/core": "0.31.0-6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-rs-core": "link:./native/core",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.0",
    "geist": "1.8.1",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "test-renderer": "1.3.1",
    "typescript": "^6.0.3",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "engines": {
    "node": ">= 22.13.0"
  },
  "codegenConfig": {
    "name": "RsVideoSpec",
    "type": "all",
    "jsSrcsDir": "src/native",
    "ios": {
      "componentProvider": {
        "RemoteSessionView": "RemoteSessionViewComponentView",
        "RsKeyCapture": "RsKeyCaptureComponentView",
        "RsQrScannerView": "RsQrScannerComponentView",
        "RsTerminalView": "RsTerminalViewComponentView"
      },
      "modulesProvider": {
        "RsDevLog": "RsDevLogModule",
        "NetInfoPlus": "RsNetInfoModule",
        "LocalAuth": "RsLocalAuthModule",
        "SecureKey": "RsSecureKeyModule",
        "RsSystem": "RsSystemModule",
        "RsLifecycle": "RsLifecycleModule",
        "RsAudio": "RsAudioModule",
        "RsFiles": "RsFilesModule",
        "RsPip": "RsPipModule",
        "RsWindow": "RsWindowModule",
        "RsBonjour": "RsBonjourModule"
      }
    },
    "android": {
      "javaPackageName": "ai.gxlself.remotescreen.specs"
    }
  }
}
